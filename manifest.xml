<?xml version="1.0" encoding="UTF-8"?>
<!--
  Manifest cho PowerPoint Content Add-in "Web Viewer".
  Thay tất cả "https://YOUR-HOST" bằng địa chỉ HTTPS nơi bạn host thư mục này
  (ví dụ: https://tenban.github.io/ppt-web-viewer).
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
           xsi:type="ContentApp">

  <Id>25a1d783-ea0c-40b0-bbb5-b154ee745345</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>My Company</ProviderName>
  <DefaultLocale>vi-VN</DefaultLocale>
  <DisplayName DefaultValue="Web Viewer" />
  <Description DefaultValue="Hiển thị trang web trực tiếp trên slide PowerPoint." />
  <IconUrl DefaultValue="https://YOUR-HOST/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://YOUR-HOST/assets/icon-64.png" />
  <SupportUrl DefaultValue="https://YOUR-HOST/" />

  <AppDomains>
    <AppDomain>https://YOUR-HOST</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Presentation" />
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://YOUR-HOST/index.html" />
    <RequestedWidth>800</RequestedWidth>
    <RequestedHeight>450</RequestedHeight>
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>
  <AllowSnapshot>true</AllowSnapshot>
</OfficeApp>
